# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project > Settings > Environment Variables.

# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# developers.giphy.com > Create an App > API key
VITE_GIPHY_API_KEY=your-giphy-key

# Set to true once Google sign-in is switched on in Supabase
VITE_ENABLE_GOOGLE=false

# Reminders: make a key pair with `npx web-push generate-vapid-keys`.
# The public key is safe to share. Keep the private key only in Vercel.
VITE_VAPID_PUBLIC_KEY=your-public-key
VAPID_PRIVATE_KEY=your-private-key

# Optional: switch features off for this deployment, comma separated.
# Names are in src/config/features.ts, e.g. publicSquads,chat,gauntlets
VITE_FEATURES_OFF=
